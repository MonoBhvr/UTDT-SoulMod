{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soulmod.dev/schema/manifest-v1.json",
  "title": "SoulMod manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "id", "name", "version", "targetFile", "targets", "operationsFile"],
  "properties": {
    "formatVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/packageId" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$" },
    "targetFile": { "$ref": "#/$defs/packagePath" },
    "targetDataSha256": { "$ref": "#/$defs/sha256" },
    "targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "targetFile"],
        "properties": {
          "id": { "$ref": "#/$defs/packageId" },
          "targetFile": { "$ref": "#/$defs/packagePath" },
          "targetDataSha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "authors": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "license": { "type": "string", "minLength": 1 },
    "dependencies": { "$ref": "#/$defs/packageIdList" },
    "loadBefore": { "$ref": "#/$defs/packageIdList" },
    "loadAfter": { "$ref": "#/$defs/packageIdList" },
    "conflictPolicy": { "enum": ["stop", "warn", "overwrite"] },
    "operationsFile": { "$ref": "#/$defs/packagePath" }
  },
  "$defs": {
    "packageId": { "type": "string", "pattern": "^[a-zA-Z0-9._-]+$" },
    "packageIdList": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/packageId" } },
    "packagePath": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9._/-]+$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }
  }
}
